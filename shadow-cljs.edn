;; The open-swift appview Worker. :esm, mirroring app-ongakuka and
;; cloud-itonami-marketplace-listing.
;;
;; worker/wrangler.jsonc's main points at ../dist/worker.js, which is THIS
;; bundle compiled from the source in src/. That is the whole point of the
;; migration recorded in docs/adr/0001: before it, main pointed at
;; svelte/.svelte-kit/cloudflare/_worker.js -- a build output absent from the
;; tree -- and worker/src/app.ts, the file that read like the application, was
;; in no bundle at all and had no package.json to build it with.
;;
;; :warnings-as-errors is not decoration. shadow treats an undeclared or renamed
;; var as a WARNING, so `shadow-cljs release worker` exits 0 while writing a
;; bundle that misbehaves on the first request -- in some repos a thrown
;; `Cannot read properties of undefined`, in others a 200 serving a degraded
;; page. "The build succeeded" was therefore not a check at all: it could not
;; fail. Demonstrated in THIS repo before landing this line
;; (docs/operator-quickstart.md S6, mutation M1).
{:deps {:aliases [:cljs]}
 :builds
 {:worker
  {:target :esm
   :output-dir "dist"
   :modules {:worker {:exports {default openswift.worker/handler}}}
   ;; NOTE the key lives under :compiler-options, NOT :build-options -- shadow
   ;; reads `[:compiler-options :warnings-as-errors]`
   ;; (shadow/build/compiler.clj `should-warning-throw?`). Putting it under
   ;; :build-options is silently ignored, which is the same failure this option
   ;; exists to prevent: a fix that cannot fail. scripts/verify-docs-claims.cljs
   ;; asserts the placement by PARSING this file, not by grepping it -- a grep
   ;; would be satisfied by this very comment.
   :compiler-options {:output-feature-set :es2020
                      :infer-externs :auto
                      :warnings-as-errors true}}}}
