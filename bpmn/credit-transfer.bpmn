<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="open-swift-credit-transfer"
                  targetNamespace="https://etzhayyim.com/bpmn/open-swift">
  <bpmn:process id="customerCreditTransfer" name="Customer Credit Transfer" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Init" name="Transfer initiated by debtor agent"/>
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_Init" targetRef="Task_CollectForm"/>
    <bpmn:userTask id="Task_CollectForm" name="Collect customer-credit-transfer form"
                   camunda:formKey="openSwift.customerCreditTransfer.v1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_CollectForm" targetRef="Task_Screen"/>
    <bpmn:businessRuleTask id="Task_Screen" name="Settlement screening (DMN)"
                           camunda:decisionRef="openSwift.screening"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Screen" targetRef="Gateway_Decision"/>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?" default="f4b"/>
    <bpmn:sequenceFlow id="f4a" sourceRef="Gateway_Decision" targetRef="Task_Send">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "APPROVE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4b" sourceRef="Gateway_Decision" targetRef="EndEvent_Rejected"/>
    <bpmn:serviceTask id="Task_Send" name="com.etzhayyim.apps.openSwift.sendCustomerCreditTransfer"
                      camunda:topic="com.etzhayyim.apps.openSwift.sendCustomerCreditTransfer"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Task_Send" targetRef="Task_AuditPost"/>
    <bpmn:serviceTask id="Task_AuditPost" name="Emit app.bsky.feed.post (participant feed)"
                      camunda:topic="app.bsky.feed.post"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Task_AuditPost" targetRef="EndEvent_Sent"/>
    <bpmn:endEvent id="EndEvent_Sent" name="Message sent"/>
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected (screening)"/>
  </bpmn:process>
</bpmn:definitions>
